generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
  SYSTEM
}

enum JharkhandDistrict {
  BOKARO
  CHATRA
  DEOGHAR
  DHANBAD
  DUMKA
  EAST_SINGHBHUM
  GARHWA
  GIRIDIH
  GODDA
  GUMLA
  HAZARIBAGH
  JAMTARA
  KHUNTI
  KODERMA
  LATEHAR
  LOHARDAGA
  PAKUR
  PALAMU
  RAMGARH
  RANCHI
  SAHEBGANJ
  SARAIKELA_KHARSAWAN
  SIMDEGA
  WEST_SINGHBHUM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  HOLD
  REJECTED
}

enum WeeklyHaatDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum CartAbandonmentStatus {
  ACTIVE
  ABANDONED
  REMINDER_SENT
  CONVERTED
  RECOVERED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PACKED
  SHIPPED
  DELIVERED
  RTO
  CANCELLED
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  RELEASED
  BLOCKED
  REVERSED
}

enum LedgerType {
  ESCROW_RELEASE
  PAYOUT_REVERSAL
  MANUAL_ADJUSTMENT
  BANK_TRANSFER
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum NotificationType {
  VENDOR_NEW_ORDER_SMS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum PaymentMethod {
  UPI
  CARD
  COD
}

enum PaymentIntentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum ModerationStatus {
  PENDING
  APPROVED
  HOLD
  REJECTED
}

enum PayoutRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum ProductLifecycleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum AdminTeamRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  MARKETING
  MODERATOR
}

enum AdminNotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AdminNotificationCategory {
  ORDER
  PAYMENT
  STOCK
  PAYOUT
  KYC
  PRODUCT
  HAAT
}

enum ProductEventType {
  IMPRESSION
  VIEW
  SEARCH_CLICK
  WISHLIST_ADD
  WISHLIST_REMOVE
  ADD_TO_CART
  REMOVE_FROM_CART
  CHECKOUT_STARTED
}

enum AnalyticsRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AnalyticsExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum ForecastConfidence {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                     String                  @id @default(cuid())
  email                  String?                 @unique
  mobile                 String                  @unique
  passwordHash           String?                 @map("password_hash")
  name                   String
  role                   UserRole                @default(CUSTOMER)
  isActive               Boolean                 @default(true) @map("is_active")
  /// Per-account brute-force lockout. IP rate limiting alone does not stop a
  /// distributed attempt against one account; these track the account itself.
  failedLoginCount       Int                     @default(0) @map("failed_login_count")
  lockedUntil            DateTime?               @map("locked_until")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  vendor                 Vendor?
  addresses              Address[]
  carts                  Cart[]
  orders                 Order[]
  statusLogs             OrderStatusLog[]        @relation("StatusActor")
  authSessions           AuthSession[]
  resetTokens            PasswordResetToken[]
  wishlist               WishlistItem[]
  couponUses             CouponRedemption[]
  applications           VendorApplication[]     @relation("ApplicationOwner")
  moderationAudits       ModerationAudit[]       @relation("Moderator")
  adminAudits            AdminAuditLog[]         @relation("AdminActor")
  productReviews         Product[]               @relation("ProductReviewer")
  adminMembership        AdminMembership?
  adminNotificationReads AdminNotificationRead[]
  productAnalyticsEvents ProductAnalyticsEvent[]
  reviews                Review[]
  reviewReports          ReviewReport[]          @relation("ReviewReporter")
  hiddenReviews          Review[]                @relation("ReviewHiddenBy")

  @@map("users")
}

model Address {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  label      String
  fullName   String            @map("full_name")
  mobile     String
  line1      String
  line2      String?
  landmark   String?
  district   JharkhandDistrict
  state      String            @default("Jharkhand")
  postalCode String            @map("postal_code")
  isDefault  Boolean           @default(false) @map("is_default")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId, isDefault])
  @@map("addresses")
}

model Vendor {
  id                 String               @id @default(cuid())
  ownerId            String               @unique @map("owner_id")
  businessName       String               @map("business_name")
  shgGroupName       String?              @map("shg_group_name")
  district           JharkhandDistrict
  region             String
  msmeNumber         String               @unique @map("msme_number")
  msmeCertificateUrl String               @map("msme_certificate_url")
  verificationStatus VerificationStatus   @default(PENDING) @map("verification_status")
  walletBalance      Decimal              @default(0) @map("wallet_balance") @db.Decimal(14, 2)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  owner              User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products           Product[]
  vendorOrders       VendorOrder[]
  walletLedgers      WalletLedger[]
  notifications      NotificationOutbox[]
  payoutRequests     PayoutRequest[]

  @@index([district, verificationStatus])
  @@map("vendors")
}

model Category {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  products             Product[]
  managedHaatOverrides ManagedHaatOverride[]

  @@map("categories")
}

model WeeklyHaat {
  id        String                @id @default(cuid())
  name      String
  district  JharkhandDistrict
  day       WeeklyHaatDay
  opensAt   String                @map("opens_at")
  closesAt  String                @map("closes_at")
  isEnabled Boolean               @default(true) @map("is_enabled")
  isLive    Boolean               @default(false) @map("is_live")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  products  Product[]
  overrides ManagedHaatOverride[]

  @@unique([district, day, name])
  @@index([day, isEnabled, isLive])
  @@map("weekly_haats")
}

model Product {
  id               String                  @id @default(cuid())
  vendorId         String                  @map("vendor_id")
  categoryId       String                  @map("category_id")
  weeklyHaatId     String?                 @map("weekly_haat_id")
  name             String
  slug             String                  @unique
  description      String
  artisanStory     String?                 @map("artisan_story")
  district         JharkhandDistrict
  weeklyHaatDay    WeeklyHaatDay           @map("weekly_haat_day")
  minPrice         Decimal                 @map("min_price") @db.Decimal(12, 2)
  isPublished      Boolean                 @default(false) @map("is_published")
  lifecycleStatus  ProductLifecycleStatus  @default(DRAFT) @map("lifecycle_status")
  moderationReason String?                 @map("moderation_reason")
  submittedAt      DateTime?               @map("submitted_at")
  reviewedAt       DateTime?               @map("reviewed_at")
  reviewerId       String?                 @map("reviewer_id")
  materials        String?
  dimensions       String?
  careInstructions String?                 @map("care_instructions")
  dispatchEstimate String?                 @map("dispatch_estimate")
  returnPolicy     String?                 @map("return_policy")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  vendor           Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category         Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  weeklyHaat       WeeklyHaat?             @relation(fields: [weeklyHaatId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  wishlistItems    WishlistItem[]
  media            ProductMedia[]
  reviewer         User?                   @relation("ProductReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  analyticsEvents  ProductAnalyticsEvent[]
  dailyAnalytics   ProductDailyAggregate[]
  healthSnapshots  ProductHealthSnapshot[]
  reviews          Review[]

  @@index([isPublished, district, weeklyHaatDay])
  @@index([categoryId, isPublished, minPrice])
  @@index([vendorId, isPublished])
  @@index([lifecycleStatus, submittedAt])
  @@map("products")
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  objectKey String   @unique @map("object_key")
  url       String
  mimeType  String   @map("mime_type")
  width     Int?
  height    Int?
  altText   String   @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_media")
}

model ProductVariant {
  id              String                  @id @default(cuid())
  productId       String                  @map("product_id")
  sku             String                  @unique
  label           String
  price           Decimal                 @db.Decimal(12, 2)
  stock           Int                     @default(0)
  lowStock        Boolean                 @default(true) @map("low_stock")
  version         Int                     @default(0)
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reservations    InventoryReservation[]
  analyticsEvents ProductAnalyticsEvent[]

  @@index([productId, isActive, stock])
  @@index([price, stock])
  @@map("product_variants")
}

model ProductAnalyticsEvent {
  id          String             @id @default(cuid())
  eventKey    String             @unique @map("event_key")
  type        ProductEventType
  productId   String             @map("product_id")
  variantId   String?            @map("variant_id")
  customerId  String?            @map("customer_id")
  sessionId   String             @map("session_id")
  district    JharkhandDistrict?
  source      String?
  searchQuery String?            @map("search_query")
  device      String?
  quantity    Int?
  price       Decimal?           @db.Decimal(12, 2)
  createdAt   DateTime           @default(now()) @map("created_at")
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customer    User?              @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, type, createdAt])
  @@index([searchQuery, createdAt])
  @@index([sessionId, createdAt])
  @@map("product_analytics_events")
}

model ProductDailyAggregate {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  date        DateTime @db.Date
  impressions Int      @default(0)
  views       Int      @default(0)
  cartAdds    Int      @default(0) @map("cart_adds")
  checkouts   Int      @default(0)
  purchases   Int      @default(0)
  unitsSold   Int      @default(0) @map("units_sold")
  revenue     Decimal  @default(0) @db.Decimal(14, 2)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("product_daily_aggregates")
}

model ProductHealthSnapshot {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  score           Int
  conversionScore Int      @map("conversion_score")
  contentScore    Int      @map("content_score")
  stockScore      Int      @map("stock_score")
  fulfilmentScore Int      @map("fulfilment_score")
  recommendations Json
  calculatedAt    DateTime @default(now()) @map("calculated_at")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, calculatedAt])
  @@map("product_health_snapshots")
}

model ProductDistrictDailyAggregate {
  id           String            @id @default(cuid())
  productId    String            @map("product_id")
  district     JharkhandDistrict
  date         DateTime          @db.Date
  views        Int               @default(0)
  cartAdds     Int               @default(0) @map("cart_adds")
  unitsSold    Int               @default(0) @map("units_sold")
  gmv          Decimal           @default(0) @db.Decimal(14, 2)
  rtoCount     Int               @default(0) @map("rto_count")
  searchDemand Int               @default(0) @map("search_demand")

  @@unique([productId, district, date])
  @@index([district, date])
  @@map("product_district_daily_aggregates")
}

model SearchQueryDailyAggregate {
  id          String             @id @default(cuid())
  query       String
  queryFamily String             @map("query_family")
  date        DateTime           @db.Date
  district    JharkhandDistrict?
  device      String?
  impressions Int                @default(0)
  clicks      Int                @default(0)
  cartAdds    Int                @default(0) @map("cart_adds")
  purchases   Int                @default(0)
  resultCount Int                @default(0) @map("result_count")

  @@unique([queryFamily, date, district, device])
  @@index([date, queryFamily])
  @@map("search_query_daily_aggregates")
}

model VariantInventoryDailyAggregate {
  id              String   @id @default(cuid())
  variantId       String   @map("variant_id")
  date            DateTime @db.Date
  openingStock    Int      @map("opening_stock")
  closingStock    Int      @map("closing_stock")
  unitsSold       Int      @default(0) @map("units_sold")
  stockoutMinutes Int      @default(0) @map("stockout_minutes")

  @@unique([variantId, date])
  @@index([date])
  @@map("variant_inventory_daily_aggregates")
}

model DemandForecastSnapshot {
  id              String             @id @default(cuid())
  variantId       String             @map("variant_id")
  forecast7       Int                @map("forecast_7")
  forecast30      Int                @map("forecast_30")
  reorderQuantity Int                @map("reorder_quantity")
  dailyVelocity   Decimal            @map("daily_velocity") @db.Decimal(12, 4)
  confidence      ForecastConfidence
  explanation     Json
  calculatedAt    DateTime           @default(now()) @map("calculated_at")

  @@index([variantId, calculatedAt])
  @@map("demand_forecast_snapshots")
}

model AnalyticsAggregationRun {
  id            String             @id @default(cuid())
  runKey        String             @unique @map("run_key")
  status        AnalyticsRunStatus
  startedAt     DateTime           @default(now()) @map("started_at")
  completedAt   DateTime?          @map("completed_at")
  error         String?
  rowsProcessed Int                @default(0) @map("rows_processed")

  @@index([status, startedAt])
  @@map("analytics_aggregation_runs")
}

model AnalyticsExportJob {
  id            String                @id @default(cuid())
  requestedById String                @map("requested_by_id")
  status        AnalyticsExportStatus @default(PENDING)
  filters       Json
  rowCount      Int?                  @map("row_count")
  objectKey     String?               @map("object_key")
  error         String?
  createdAt     DateTime              @default(now()) @map("created_at")
  completedAt   DateTime?             @map("completed_at")
  expiresAt     DateTime?             @map("expires_at")

  @@index([requestedById, createdAt])
  @@map("analytics_export_jobs")
}

model Cart {
  id                String                @id @default(cuid())
  customerId        String                @map("customer_id")
  abandonmentStatus CartAbandonmentStatus @default(ACTIVE) @map("abandonment_status")
  abandonedAt       DateTime?             @map("abandoned_at")
  lastReminderAt    DateTime?             @map("last_reminder_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  customer          User                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items             CartItem[]
  order             Order?

  @@index([customerId, abandonmentStatus])
  @@index([abandonmentStatus, updatedAt])
  /// The abandonment rate counts carts created inside the window.
  @@index([createdAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String         @map("cart_id")
  variantId String         @map("variant_id")
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique @map("order_number")
  idempotencyKey    String            @unique @map("idempotency_key")
  customerId        String            @map("customer_id")
  cartId            String            @unique @map("cart_id")
  deliveryAddressId String            @map("delivery_address_id")
  gmv               Decimal           @db.Decimal(14, 2)
  discount          Decimal           @default(0) @db.Decimal(14, 2)
  cgst              Decimal           @db.Decimal(14, 2)
  sgst              Decimal           @db.Decimal(14, 2)
  courierCharge     Decimal           @map("courier_charge") @db.Decimal(12, 2)
  totalPayable      Decimal           @map("total_payable") @db.Decimal(14, 2)
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  couponCode        String?           @map("coupon_code")
  couponFinalized   Boolean           @default(false) @map("coupon_finalized")
  recipientName     String            @map("recipient_name")
  recipientMobile   String            @map("recipient_mobile")
  addressLine1      String            @map("address_line1")
  addressLine2      String?           @map("address_line2")
  district          JharkhandDistrict
  postalCode        String            @map("postal_code")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  customer          User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cart              Cart              @relation(fields: [cartId], references: [id], onDelete: Restrict)
  deliveryAddress   Address           @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  vendorOrders      VendorOrder[]
  paymentIntents    PaymentIntent[]
  couponRedemption  CouponRedemption?
  reviews           Review[]

  @@index([customerId, createdAt])
  @@index([paymentStatus, createdAt])
  /// Month-bucketed analytics scan the window on createdAt alone; neither
  /// composite index above leads with it, so neither can serve that scan.
  @@index([createdAt])
  @@map("orders")
}

model VendorOrder {
  id              String               @id @default(cuid())
  orderId         String               @map("order_id")
  vendorId        String               @map("vendor_id")
  trackingId      String               @unique @map("tracking_id")
  status          FulfillmentStatus    @default(PENDING)
  payoutStatus    PayoutStatus         @default(PENDING) @map("payout_status")
  gmv             Decimal              @db.Decimal(14, 2)
  adminCommission Decimal              @map("admin_commission") @db.Decimal(14, 2)
  cgst            Decimal              @db.Decimal(14, 2)
  sgst            Decimal              @db.Decimal(14, 2)
  courierCharge   Decimal              @map("courier_charge") @db.Decimal(12, 2)
  netVendorPayout Decimal              @map("net_vendor_payout") @db.Decimal(14, 2)
  deliveredAt     DateTime?            @map("delivered_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusLogs      OrderStatusLog[]
  walletLedgers   WalletLedger[]
  notifications   NotificationOutbox[]

  @@unique([orderId, vendorId])
  @@index([vendorId, status, createdAt])
  @@index([status, payoutStatus])
  /// Windowed consignment aggregates filter on status and createdAt with no
  /// vendor, which the vendor-leading index above cannot serve.
  @@index([status, createdAt])
  @@map("vendor_orders")
}

model OrderItem {
  id            String         @id @default(cuid())
  vendorOrderId String         @map("vendor_order_id")
  variantId     String         @map("variant_id")
  productName   String         @map("product_name")
  variantLabel  String         @map("variant_label")
  sku           String
  quantity      Int
  unitPrice     Decimal        @map("unit_price") @db.Decimal(12, 2)
  lineTotal     Decimal        @map("line_total") @db.Decimal(14, 2)
  vendorOrder   VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([vendorOrderId])
  @@map("order_items")
}

model OrderStatusLog {
  id            String            @id @default(cuid())
  vendorOrderId String            @map("vendor_order_id")
  status        FulfillmentStatus
  actorUserId   String?           @map("actor_user_id")
  note          String?
  createdAt     DateTime          @default(now()) @map("created_at")
  vendorOrder   VendorOrder       @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  actor         User?             @relation("StatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([vendorOrderId, createdAt])
  @@map("order_status_logs")
}

model WalletLedger {
  id            String          @id @default(cuid())
  vendorId      String          @map("vendor_id")
  vendorOrderId String          @map("vendor_order_id")
  type          LedgerType
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(14, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(14, 2)
  reference     String          @unique
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")
  vendor        Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorOrder   VendorOrder     @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)

  @@unique([vendorId, vendorOrderId, type])
  @@index([vendorId, createdAt])
  @@map("wallet_ledgers")
}

model NotificationOutbox {
  id            String             @id @default(cuid())
  vendorId      String             @map("vendor_id")
  vendorOrderId String             @map("vendor_order_id")
  type          NotificationType
  recipient     String
  payload       Json
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?            @map("last_error")
  processedAt   DateTime?          @map("processed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  vendor        Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorOrder   VendorOrder        @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("notification_outbox")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  familyId         String    @map("family_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
