/// Editable role -> permission matrix, managed from Settings > Permissions.
/// Seeded from the code defaults; a role with no rows falls back to them, so an
/// empty table can never lock everyone out. SUPER_ADMIN is never read from here
/// — it always holds every permission, by construction.
model RolePermission {
  id         String        @id @default(cuid())
  role       AdminTeamRole
  permission String
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

/// A customer's review of a product they actually received.
///
/// `orderId` is not decoration: it is the entitlement. A review may only be
/// written against a DELIVERED order that contained the product, which is what
/// makes "Verified buyer" true rather than a label. The unique constraint is on
/// the triple, so a customer who buys the same product twice may review it once
/// per order — and never twice for the same one.
model Review {
  id           String         @id @default(cuid())
  productId    String         @map("product_id")
  userId       String         @map("user_id")
  orderId      String         @map("order_id")
  rating       Int
  body         String?
  /// Hidden reviews stay in the table. Removing the row would also remove the
  /// evidence of why it was removed, and would silently change a product's
  /// average with nothing recording that it happened.
  isHidden     Boolean        @default(false) @map("is_hidden")
  hiddenReason String?        @map("hidden_reason")
  hiddenById   String?        @map("hidden_by_id")
  hiddenAt     DateTime?      @map("hidden_at")
  reportCount  Int            @default(0) @map("report_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  hiddenBy     User?          @relation("ReviewHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  media        ReviewMedia[]
  reports      ReviewReport[]

  @@unique([productId, userId, orderId])
  @@index([productId, isHidden, createdAt])
  @@index([reportCount, isHidden])
  @@map("reviews")
}

model ReviewMedia {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  objectKey String   @unique @map("object_key")
  url       String
  altText   String   @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
  @@map("review_media")
}

/// One report per person per review, enforced by the unique constraint, so
/// `reportCount` cannot be inflated by one account clicking repeatedly.
model ReviewReport {
  id         String   @id @default(cuid())
  reviewId   String   @map("review_id")
  reporterId String   @map("reporter_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User     @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([reviewId, reporterId])
  @@index([reviewId, createdAt])
  @@map("review_reports")
}
