NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=joharhaat-api
JWT_AUDIENCE=joharhaat-web
CORS_ORIGINS=http://localhost:3000,https://joharhaat-jharkhand.joharxp.chatgpt.site
ADMIN_COMMISSION_RATE=0.10
CGST_RATE=0.025
SGST_RATE=0.025
LOW_STOCK_THRESHOLD=5
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
SMS_PROVIDER=mock
SMS_FROM=JOHARHAAT
LOG_LEVEL=info
