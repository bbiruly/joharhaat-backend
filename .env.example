NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=joharhaat-api
JWT_AUDIENCE=joharhaat-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
COOKIE_SECURE=false
MOCK_WEBHOOK_SECRET=mock-webhook-secret-change-me
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/mock-uploads
CORS_ORIGINS=http://localhost:3000,https://joharhaat-jharkhand.joharxp.chatgpt.site
ADMIN_COMMISSION_RATE=0.10
# Product GST is configured per product by an admin. Delivery tax is configured
# independently after confirming the fulfillment/invoicing treatment.
DELIVERY_GST_RATE=0
GST_REGISTRATION_STATE=Jharkhand
LOW_STOCK_THRESHOLD=5
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
# SMS remains intentionally disabled until a DLT-compatible provider is selected.
SMS_PROVIDER=mock
SMS_FROM=JOHARHAAT
PAYMENT_PROVIDER=razorpay
# Server-side credentials only. The public RAZORPAY_KEY_ID is returned to the
# browser with each payment intent; never expose the secret or webhook secret.
# Use test-mode keys locally/staging and live-mode keys only in production.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Asset storage and delivery via private S3 + CloudFront
AWS_REGION=ap-south-1
AWS_S3_BUCKET=joharxp-assets-764847371775-ap-south-1-an
AWS_CLOUDFRONT_DOMAIN=cdn.joharxp.com

AWS_ACCESS_KEY_ID=replace-with-rotated-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-rotated-aws-secret-access-key

RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
EMAIL_FROM=JoharHaat <noreply@example.com>
EMAIL_REPLY_TO=support@example.com
FRONTEND_BASE_URL=https://example.com
LOG_LEVEL=info

# Optional: lets exactly one known account reach the admin panel before any
# AdminMembership row exists. Unset it once a real SUPER_ADMIN is seeded.
ADMIN_BOOTSTRAP_EMAIL=

# Shared secret for machine callers (cron, schedulers). Min 32 chars.
# Sent as the x-api-key header. Never ship this to a browser.
SYSTEM_API_KEY=8f4c19e8a4c75b67c8d92e7d53a11c45b2732fa67e84d87a65c8cafe9f12d340
